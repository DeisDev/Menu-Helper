	"$MenuHelper_Ctrl": "Ctrl",
	"$MenuHelper_Alt": "Alt",
	// Rows of the color editor.
	"$MenuHelper_Red": "RED",
	"$MenuHelper_Green": "GREEN",
	"$MenuHelper_Blue": "BLUE",
	"$MenuHelper_Alpha": "ALPHA",
	// Decimal separator of slider values, for example "," in German.
	"$MenuHelper_DecimalSeparator": "."
